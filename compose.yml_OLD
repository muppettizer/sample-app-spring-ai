# Mistral 7B Instruct (good at structured JSON)

services:
  model-init:
    image: curlimages/curl:latest
    volumes:
      - ./models:/models
    entrypoint:
      - sh
      - -c
      - |
        mkdir -p /models
        if [ ! -f /models/mistral.gguf ]; then
          echo 'Downloading model...'
          curl -L -o /models/mistral.gguf https://huggingface.co/bartowski/Mistral-7B-Instruct-v0.3-GGUF/resolve/main/Mistral-7B-Instruct-v0.3-Q4_K_M.gguf
        else
          echo 'Model already exists'
        fi
        echo 'Done'

  local-ai:
    image: localai/localai:latest
    ports:
      - "8083:8080"
    volumes:
      - ./models:/models
      - ./localai:/root/.local/share/local-ai
    depends_on:
      - model-init
    environment:
      - DEBUG=true
      - THREADS=4
      - CONTEXT_SIZE=4096
    restart: unless-stopped
